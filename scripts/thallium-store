#!/usr/bin/env bash
set -euo pipefail

if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
ui_path="$data_home/thallium-store/ui/shell.qml"

if [ ! -f "$ui_path" ]; then
  if [ -f "/usr/share/thallium-store/ui/shell.qml" ]; then
    ui_path="/usr/share/thallium-store/ui/shell.qml"
  else
    ui_path="$repo_dir/ui/shell.qml"
  fi
fi

# `thallium-store <file.AppImage>`: the file manager's open-with. A running
# store is told over IPC so a second window does not appear; otherwise the
# path rides in on the environment for the fresh instance to pick up.
open_file=""
if [ "${1:-}" != "" ] && [ -f "$1" ]; then
  open_file="$(realpath -- "$1")"
  if quickshell ipc -p "$ui_path" call store openFile "$open_file" >/dev/null 2>&1; then
    exit 0
  fi
fi

export PATH="$HOME/.local/bin:$repo_dir/target/debug:$PATH"
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
export UNI_PRIVILEGE_BACKEND="${UNI_PRIVILEGE_BACKEND:-pkexec}"
export THALLIUM_STORE_FAKE_UNI="${THALLIUM_STORE_FAKE_UNI:-0}"

if [ -n "$open_file" ]; then
  export THALLIUM_STORE_OPEN_FILE="$open_file"
fi
exec quickshell --path "$ui_path"
