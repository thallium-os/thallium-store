#!/usr/bin/env bash
set -euo pipefail

if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
uni_path="$data_home/thallium-store/uni/uni"

if [ ! -x "$uni_path" ]; then
  if [ -x "/usr/lib/thallium-store/uni/uni" ]; then
    uni_path="/usr/lib/thallium-store/uni/uni"
  elif [ -x "$repo_dir/vendor/uni/uni" ]; then
    uni_path="$repo_dir/vendor/uni/uni"
  fi
fi

export PATH="$HOME/.local/bin:$repo_dir/target/debug:$PATH"
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
export UNI_PRIVILEGE_BACKEND="${UNI_PRIVILEGE_BACKEND:-pkexec}"
if [ -x "$uni_path" ]; then
  export THALLIUM_STORE_UNI="${THALLIUM_STORE_UNI:-$uni_path}"
fi
export THALLIUM_STORE_FAKE_UNI="${THALLIUM_STORE_FAKE_UNI:-0}"

native_binary="${THALLIUM_STORE_NATIVE:-}"
if [ -z "$native_binary" ]; then
  for candidate in \
    "$HOME/.local/libexec/thallium-store/thallium-store-native" \
    "/usr/libexec/thallium-store/thallium-store-native" \
    "$repo_dir/target/native/thallium-store-native"; do
    if [ -x "$candidate" ]; then
      native_binary="$candidate"
      break
    fi
  done
fi

if [ -n "$native_binary" ] && [ -x "$native_binary" ]; then
  exec "$native_binary"
fi

# Keep the loopback browser client as a recovery path for packages built before
# the Qt client or systems where the native payload was removed manually.
exec thallium-store-backend --web
