cmd_search_json() {
    local query="" sources="apt,flatpak,github"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) shift ;;
            --source|-s)
                shift
                sources="${1:-}"
                shift || true
                ;;
            --source=*)
                sources="${1#*=}"
                shift
                ;;
            *)
                if [[ -z "$query" ]]; then
                    query="$1"
                fi
                shift
                ;;
        esac
    done
    [[ -z "$query" ]] && die "Usage: uni search <query> --json [--source apt|flatpak|github|snap]"

    python3 - "$query" "$sources" << 'PYEOF'
import json, subprocess, sys, urllib.parse, urllib.request

query = sys.argv[1]
sources = {s.strip().lower() for s in sys.argv[2].replace(";", ",").split(",") if s.strip()}
if "system" in sources:
    sources.add("apt")
if "flathub" in sources:
    sources.add("flatpak")
if not sources:
    sources = {"apt", "flatpak", "github"}

results = []
providers = []

def add_provider(source, state, message=None):
    providers.append({"source": source, "state": state, "message": message})

def run(cmd):
    try:
        return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=8)
    except FileNotFoundError:
        return None
    except subprocess.TimeoutExpired as exc:
        return exc

if "apt" in sources:
    policy = run(["apt-cache", "policy", query])
    if policy is None:
        add_provider("apt", "missing", "apt-cache not found")
    elif isinstance(policy, subprocess.TimeoutExpired):
        add_provider("apt", "failed", "apt-cache timed out")
    else:
        candidate = ""
        for line in policy.stdout.splitlines():
            if "Candidate:" in line:
                candidate = line.split("Candidate:", 1)[1].strip()
                break
        if candidate and candidate != "(none)":
            show = run(["apt-cache", "show", query])
            summary = "System package"
            if show and not isinstance(show, subprocess.TimeoutExpired):
                for line in show.stdout.splitlines():
                    if line.startswith("Description:"):
                        summary = line.split(":", 1)[1].strip()
                        break
            results.append({
                "id": query,
                "name": query,
                "summary": summary,
                "source": "apt",
                "packageId": query,
                "version": candidate,
                "verified": True,
                "trust": "system_access",
                "command": ["uni", "install", query, "--source", "apt"],
            })
        add_provider("apt", "ready")

if "flatpak" in sources:
    fp = run(["flatpak", "search", "--columns=application,name,description", query])
    if fp is None:
        add_provider("flatpak", "missing", "flatpak not found")
    elif isinstance(fp, subprocess.TimeoutExpired):
        add_provider("flatpak", "failed", "flatpak search timed out")
    else:
        if fp.returncode == 0:
            for line in fp.stdout.splitlines():
                cols = line.split("\t")
                if len(cols) < 1 or not cols[0].strip():
                    continue
                app_id = cols[0].strip()
                if app_id.lower() == "no matches found":
                    continue
                name = cols[1].strip() if len(cols) > 1 and cols[1].strip() else app_id
                summary = cols[2].strip() if len(cols) > 2 and cols[2].strip() else "Flatpak application"
                results.append({
                    "id": app_id,
                    "name": name,
                    "summary": summary,
                    "source": "flatpak",
                    "packageId": app_id,
                    "verified": True,
                    "trust": "sandboxed",
                    "command": ["uni", "install", app_id, "--source", "flatpak"],
                })
            add_provider("flatpak", "ready")
        else:
            add_provider("flatpak", "failed", fp.stderr.strip() or "flatpak search failed")

if "snap" in sources:
    snap = run(["snap", "find", query])
    if snap is None:
        add_provider("snap", "missing", "snap not found")
    elif isinstance(snap, subprocess.TimeoutExpired):
        add_provider("snap", "failed", "snap find timed out")
    else:
        if snap.returncode == 0:
            for line in snap.stdout.splitlines()[1:6]:
                cols = line.split()
                if cols:
                    results.append({
                        "id": cols[0],
                        "name": cols[0],
                        "summary": "Snap package",
                        "source": "snap",
                        "packageId": cols[0],
                        "verified": False,
                        "trust": "system_access",
                        "command": ["uni", "install", cols[0], "--source", "snap"],
                    })
            add_provider("snap", "ready")
        else:
            add_provider("snap", "failed", snap.stderr.strip() or "snap find failed")

if "github" in sources:
    try:
        url = "https://api.github.com/search/repositories?q=" + urllib.parse.quote(query + " in:name") + "&sort=stars&per_page=5"
        req = urllib.request.Request(url, headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "uni-json/1",
        })
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        for item in data.get("items", [])[:5]:
            repo = item.get("full_name", "")
            if not repo:
                continue
            results.append({
                "id": repo,
                "name": item.get("name") or repo,
                "summary": item.get("description") or "GitHub release",
                "source": "github",
                "packageId": repo,
                "verified": False,
                "trust": "unverified",
                "stars": item.get("stargazers_count", 0),
                "homepage": item.get("homepage") or item.get("html_url"),
                "command": ["uni", "install", repo, "--source", "github"],
            })
        add_provider("github", "ready")
    except Exception as exc:
        add_provider("github", "failed", str(exc))

print(json.dumps({
    "schemaVersion": 1,
    "query": query,
    "results": results,
    "providers": providers,
}, separators=(",", ":")))
PYEOF
}

cmd_info_json() {
    local pkg="" source=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) shift ;;
            --source|-s)
                shift
                source="${1:-}"
                shift || true
                ;;
            --source=*)
                source="${1#*=}"
                shift
                ;;
            *)
                if [[ -z "$pkg" ]]; then
                    pkg="$1"
                fi
                shift
                ;;
        esac
    done
    [[ -z "$pkg" ]] && die "Usage: uni info <id> --source <source> --json"
    [[ -z "$source" ]] && source="auto"

    python3 - "$pkg" "$source" << 'PYEOF'
import json, subprocess, sys, urllib.request

pkg, source = sys.argv[1], sys.argv[2].lower()
obj = {
    "schemaVersion": 1,
    "id": pkg,
    "packageId": pkg,
    "source": source,
    "name": pkg,
    "installed": False,
    "metadata": {},
}

def run(cmd):
    try:
        return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=8)
    except Exception:
        return None

if source in ("apt", "system", "auto"):
    dpkg = run(["dpkg-query", "-W", "-f=${Package}\t${Version}\t${binary:Summary}\n", pkg])
    if dpkg and dpkg.returncode == 0 and dpkg.stdout.strip():
        cols = dpkg.stdout.split("\t")
        obj.update({"source": "apt", "installed": True, "version": cols[1].strip() if len(cols) > 1 else None})
        obj["summary"] = cols[2].strip() if len(cols) > 2 else "System package"
    show = run(["apt-cache", "show", pkg])
    if show and show.returncode == 0:
        for line in show.stdout.splitlines():
            if line.startswith("Description:") and "summary" not in obj:
                obj["summary"] = line.split(":", 1)[1].strip()
            elif line.startswith("Homepage:"):
                obj["homepage"] = line.split(":", 1)[1].strip()
            elif line.startswith("License:"):
                obj["license"] = line.split(":", 1)[1].strip()

if source in ("flatpak", "flathub", "auto"):
    fp = run(["flatpak", "info", pkg])
    if fp and fp.returncode == 0:
        obj.update({"source": "flatpak", "installed": True, "trust": "sandboxed"})
        for line in fp.stdout.splitlines():
            if ":" not in line:
                continue
            key, value = [part.strip() for part in line.split(":", 1)]
            obj["metadata"][key] = value
            if key.lower() == "version":
                obj["version"] = value
    if source in ("flatpak", "flathub") and "summary" not in obj:
        search = run(["flatpak", "search", "--columns=application,name,description", pkg])
        if search and search.returncode == 0:
            for line in search.stdout.splitlines():
                cols = line.split("\t")
                if cols and cols[0].strip() == pkg:
                    obj["name"] = cols[1].strip() if len(cols) > 1 and cols[1].strip() else pkg
                    obj["summary"] = cols[2].strip() if len(cols) > 2 and cols[2].strip() else "Flatpak application"
                    obj["source"] = "flatpak"
                    obj["trust"] = "sandboxed"
                    break

if source in ("github", "gh"):
    obj.update({"source": "github", "trust": "unverified"})
    try:
        req = urllib.request.Request(f"https://api.github.com/repos/{pkg}/releases/latest", headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "uni-json/1",
        })
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        obj["version"] = data.get("tag_name")
        obj["summary"] = data.get("name") or "Latest GitHub release"
        obj["assets"] = [
            {
                "name": a.get("name"),
                "size": a.get("size"),
                "downloadUrl": a.get("browser_download_url"),
            }
            for a in data.get("assets", [])
        ]
    except Exception as exc:
        obj["error"] = str(exc)

print(json.dumps(obj, separators=(",", ":")))
PYEOF
}

