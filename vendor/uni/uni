# ── Entry point ──────────────────────────────────────────────
main() {
    local cmd="${1:-help}"
    shift || true

    # Machine-readable commands must not print banners, colors, or update notices.
    case "$cmd" in
        search)
            if [[ " $* " == *" --json "* ]]; then cmd_search_json "$@"; return; fi
            ;;
        info)
            if [[ " $* " == *" --json "* ]]; then cmd_info_json "$@"; return; fi
            ;;
        installed)
            if [[ $# -eq 0 || " $* " == *" --json "* ]]; then cmd_installed_json "$@"; return; fi
            ;;
        updates)
            if [[ $# -eq 0 || " $* " == *" --json "* ]]; then cmd_updates_json "$@"; return; fi
            ;;
        list)
            if [[ " $* " == *" --json "* ]]; then cmd_installed_json "$@"; return; fi
            ;;
        install|remove|update)
            if [[ " $* " == *" --json-events "* ]]; then cmd_json_events_wrapper "$cmd" "$@"; return; fi
            ;;
    esac

    # Kick off background update check on human-readable runs only.
    check_for_update

    case "$cmd" in
        install)                cmd_install "$@" ;;
        remove)                 cmd_remove  "$@" ;;
        purge)                  cmd_purge   "$@" ;;
        list)                   cmd_list ;;
        search)                 [[ $# -gt 0 ]] && cmd_search_json "$@" --json || die "Usage: uni search <query> --json" ;;
        info)                   [[ $# -gt 0 ]] && cmd_info_json "$@" --json || die "Usage: uni info <id> --source <source> --json" ;;
        installed)              cmd_installed_json ;;
        updates)                cmd_updates_json ;;
        update)                 cmd_update ;;
        self-update|--update)   cmd_self_update "$@" ;;
        uninstall)              cmd_uninstall ;;
        intercept)              cmd_intercept "$@" ;;
        
        version|--version|-V)   echo "uni v${UNI_VERSION}"; return 0 ;;
        help|--help|-h)         cmd_help ;;
        *) error "Unknown command: ${cmd}"; cmd_help; exit 1 ;;
    esac

    # Print update banner after the command finishes (if one was found)
    print_update_banner
}

main "$@"
