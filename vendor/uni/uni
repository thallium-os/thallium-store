# ── JSON helpers ─────────────────────────────────────────────
json_event() {
    local event="$1" state="$2" progress="$3" message="$4" package="${5:-}" source="${6:-}" exit_code="${7:-}"
    python3 - "$event" "$state" "$progress" "$message" "$package" "$source" "$exit_code" << 'PYEOF'
import json, re, sys, time
event, state, progress, message, package, source, exit_code = sys.argv[1:8]
ansi = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
message = ansi.sub("", message)
obj = {
    "schemaVersion": 1,
    "event": event,
    "state": state,
    "progress": int(progress),
    "message": message,
    "timestamp": int(time.time()),
}
if package:
    obj["package"] = package
if source:
    obj["source"] = source
if exit_code:
    obj["exitCode"] = int(exit_code)
print(json.dumps(obj, separators=(",", ":")), flush=True)
PYEOF
}

